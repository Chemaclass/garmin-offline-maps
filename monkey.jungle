project.manifest = manifest.xml

# source/generated holds MapIndex.mc, which tools/mappack rewrites on every
# `make pack`. mapdata/active holds the packed tiles as jsonData resources.
base.sourcePath = source
base.resourcePath = resources;mapdata/active

# Launcher icons, per device.
#
# Every device gets the same artwork at its own native size. Without this the
# compiler scales the 70x70 base icon and warns once per build, on 20 of the 24
# products. `resources/` stays the 70x70 default, so a device added here and
# forgotten below still builds -- it just gets the scaled icon and says so.
#
# The sizes come from each device definition's `launcherIcon` field; regenerate
# a folder with:
#     sips -Z <size> resources/drawables/launcher_icon.png \
#          --out resources-icon<size>/drawables/launcher_icon.png

venusq2.resourcePath = $(venusq2.resourcePath);resources-icon40
venusq2m.resourcePath = $(venusq2m.resourcePath);resources-icon40
fr955.resourcePath = $(fr955.resourcePath);resources-icon40

venu441mm.resourcePath = $(venu441mm.resourcePath);resources-icon54
vivoactive6.resourcePath = $(vivoactive6.resourcePath);resources-icon54
fr165.resourcePath = $(fr165.resourcePath);resources-icon54
fr165m.resourcePath = $(fr165m.resourcePath);resources-icon54
fr170.resourcePath = $(fr170.resourcePath);resources-icon54
fr170m.resourcePath = $(fr170m.resourcePath);resources-icon54
fr57042mm.resourcePath = $(fr57042mm.resourcePath);resources-icon54
fr70.resourcePath = $(fr70.resourcePath);resources-icon54

vivoactive5.resourcePath = $(vivoactive5.resourcePath);resources-icon56

fr265.resourcePath = $(fr265.resourcePath);resources-icon60
fr265s.resourcePath = $(fr265s.resourcePath);resources-icon60

venu2s.resourcePath = $(venu2s.resourcePath);resources-icon61

venu445mm.resourcePath = $(venu445mm.resourcePath);resources-icon65
venux1.resourcePath = $(venux1.resourcePath);resources-icon65
fr57047mm.resourcePath = $(fr57047mm.resourcePath);resources-icon65
fr965.resourcePath = $(fr965.resourcePath);resources-icon65
fr970.resourcePath = $(fr970.resourcePath);resources-icon65
