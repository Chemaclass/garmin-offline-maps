<?xml version="1.0"?>
<!--
  Adding a device? Put its product id here, run `make pack` again if the new
  screen is much bigger, and check docs/DEVICES.md first -- watch-app memory
  differs a lot between models and the map buffer is the first thing to break.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="846d5a3e7f114f88b1387ee15adb2afd"
        type="watch-app"
        name="@Strings.AppName"
        entry="OfflineMapsApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="4.2.1">

        <iq:products>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>

        <!-- To add a language, create resources-<code>/strings/strings.xml and
             list that folder in monkey.jungle's resourcePath. -->
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
