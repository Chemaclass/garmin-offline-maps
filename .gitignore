# Build output
bin/
*.prg
*.prg.debug.xml
*.iq

# Signing keys -- never commit these; the store ties your app id to the key
developer_key
developer_key.pem
*.der

# Claude Code -- .claude/ is shared; local overrides are not
.claude/settings.local.json

# Editors
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Preview renders, except the ones the README shows
preview*.png
!docs/img/preview*.png

# Overpass caches
*.osm.cache
tools/mappack/*.osm

# The demo pack IS committed so the repo builds out of the box. If you generate
# a large pack for your own area, uncomment the next line so it stays local.
# mapdata/active/
.DS_Store

# Personal packs built alongside the committed demo
mapdata/berlin/

# Local city catalogue for `make catalogue`
.catalogue/
